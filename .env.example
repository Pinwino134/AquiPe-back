# Copia este archivo como .env y ajusta los valores.
# Local (docker compose up -d):
DATABASE_URL=postgresql://aquipe:aquipe@localhost:5432/aquipe
# Supabase / Neon: pega aquí la cadena de conexión que te dan (con postgresql://)

# Orígenes permitidos por CORS (separados por coma). "*" = todos (solo para desarrollo).
CORS_ORIGINS=*
